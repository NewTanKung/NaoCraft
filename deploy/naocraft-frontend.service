[Unit]
Description=NaoCraft Frontend Service (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/naocraft/frontend
ExecStart=/usr/local/bin/bun run start -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=API_BASE=http://127.0.0.1:4000

[Install]
WantedBy=multi-user.target
